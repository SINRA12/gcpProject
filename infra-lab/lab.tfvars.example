# Copy to lab.tfvars and fill in. Shared by every stage.
# In GitHub Actions this file is generated from repository variables instead.

project_id   = "your-project-id"
region       = "asia-southeast1"
zone         = "asia-southeast1-a"
state_bucket = "your-project-id-tfstate" # created by bootstrap/setup-gcp.sh

# Public IPs allowed through Cloud Armor, in CIDR form.
# Find Cloud Shell's with `curl -s ifconfig.me`, your laptop's by searching "what is my IP".
# With Cloudflare enabled, set this to [] so the only way in is through Cloudflare.
my_ips = ["203.0.113.10/32"]

# GKE node size. e2-standard-2 (2 vCPU, 8 GB) fits the monitoring stack. e2-medium is about
# half the price but runs out of CPU once Prometheus and Grafana are installed.
node_machine_type = "e2-standard-2"

# Cloud Armor (stage 4). Off by default: new projects often have a security-policies
# quota of 0 ("Quota 'SECURITY_POLICIES' exceeded"). With it off, the load balancer is
# open to the internet. Request the quota, then set this to true.
enable_armor = false

# Cloudflare stage (optional). Needs a domain on Cloudflare and
# CLOUDFLARE_API_TOKEN exported in your shell (or as a GitHub secret).
enable_cloudflare  = false
domain             = "example.com"
cloudflare_zone_id = "your-zone-id"
record_name        = "lab"

# Delivery stage (6): Jenkins builds the sample Java service, Argo CD deploys it.
# Not set here: export GITHUB_TOKEN (write access to the repository) before ./lab.sh up, so Jenkins can
# commit image tags. See docs/runbook.md, section 9. Optional overrides:
# git_repo_url         = "https://github.com/SINRA12/gcpProject.git"
# gitops_revision      = "main"    # a branch name, to try the chart before merging (Jenkins only tags main)
# jenkins_machine_type = "e2-standard-2"
# Jenkins and Argo CD are public by default, each on its own IP (HTTPS, self-signed certificate, protected by their
# logins). ui_source_ranges limits who can connect: the default allows the whole internet. [] = no public IPs, use
# the IAP tunnel and kubectl port-forward (scripts/laptop-access.sh). Each public UI uses one IN_USE_ADDRESSES.
# ui_source_ranges = ["0.0.0.0/0"]

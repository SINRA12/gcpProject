{
  "uid": "infra-lab-edge",
  "title": "Edge: load balancer and HAProxy",
  "description": "4xx, 5xx and response time at the public load balancer and at HAProxy.",
  "tags": [
    "infra-lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Classic load balancer (Cloud Monitoring)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by response class",
      "description": "What users get back from the public IP: 200, 300, 400 (client errors) and 500 (server errors).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "targets": [
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "A",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/request_count",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [
              "metric.label.response_code_class"
            ],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "{{metric.label.response_code_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency seen by the client (total_latencies)",
      "description": "Time from the load balancer receiving the request to the last byte of the response.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "targets": [
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "A",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/total_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p50"
        },
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "B",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/total_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p95"
        },
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "C",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/total_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency of the backend (backend_latencies)",
      "description": "Time the HAProxy VMs (and everything behind them) took. The gap to the chart on the left is the load balancer's own time.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "targets": [
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "A",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/backend_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p50"
        },
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "B",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/backend_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p95"
        },
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "C",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/backend_latencies",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second by backend response code",
      "description": "Exact status codes, for example 404 versus 502.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "targets": [
        {
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "refId": "A",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "loadbalancing.googleapis.com/https/request_count",
              "AND",
              "resource.type",
              "=",
              "https_lb_rule"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [
              "metric.label.response_code"
            ],
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "{{metric.label.response_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "HAProxy (scraped from :8404/metrics on each VM)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HAProxy responses per second by class",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(haproxy_frontend_http_responses_total{proxy=\"main\"}[1m]))",
          "legendFormat": "{{code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HAProxy error ratio",
      "description": "Share of responses that were errors, over 5 minutes.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(haproxy_frontend_http_responses_total{proxy=\"main\",code=\"5xx\"}[5m])) / sum(rate(haproxy_frontend_http_responses_total{proxy=\"main\"}[5m]))",
          "legendFormat": "5xx",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(haproxy_frontend_http_responses_total{proxy=\"main\",code=\"4xx\"}[5m])) / sum(rate(haproxy_frontend_http_responses_total{proxy=\"main\"}[5m]))",
          "legendFormat": "4xx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Response time per backend",
      "description": "HAProxy's average response time over the last 1024 requests, per backend.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (proxy) (haproxy_backend_response_time_average_seconds) * 1000",
          "legendFormat": "{{proxy}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per second by backend",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (rate(haproxy_backend_http_requests_total[1m]))",
          "legendFormat": "{{proxy}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Backends up (1 = up)",
      "description": "HAProxy's own health check of each ingress-nginx backend.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (proxy) (haproxy_backend_up{proxy!=\"no_match\"})",
          "legendFormat": "{{proxy}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "HAProxy VMs being scraped",
      "description": "Should equal the number of HAProxy VMs. 0 means the scrape or the exporter is not working.",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-flight"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"haproxy\"} == 1)",
          "legendFormat": "up",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    }
  ]
}
